@using CncMes.Domain.Identity

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CncMes</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Ana Sayfa
            </NavLink>
        </div>

        <AuthorizeView Roles="@Roles.Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Admin Paneli
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/pricing">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Fiyatlandırma
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/materials">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Hammaddeler
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Manager">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="manager" Match="NavLinkMatch.All">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Yönetici Paneli
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="manager/customers">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Müşteriler
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="manager/orders">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Siparişler
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="manager/jobs">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> İş Emirleri
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="manager/reports">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Kar / Zarar
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Operator">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="operator" Match="NavLinkMatch.All">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> İşlerim
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>
