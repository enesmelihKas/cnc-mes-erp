@using CncMes.Domain.Identity

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CncMes</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Ana Sayfa
            </NavLink>
        </div>

        <AuthorizeView Roles="@Roles.Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Admin Paneli
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Manager">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="manager">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Yönetici Paneli
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Operator">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="operator">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Operatör Paneli
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>
