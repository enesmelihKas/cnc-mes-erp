@page "/manager/orders/{Id:int}"
@attribute [Authorize(Roles = Roles.Manager)]
@using CncMes.Application.Production
@using CncMes.Application.Reporting
@using CncMes.Application.Sales
@using CncMes.Application.Sales.Requests
@using CncMes.Domain.Sales
@using Microsoft.Maui.Storage
@using Microsoft.Maui.ApplicationModel
@inject ICustomerService Customers
@inject IOrderService Orders
@inject IJobService Jobs
@inject IProfitLossService ProfitLoss
@inject IProfitLossReportPdf ReportPdf
@inject NavigationManager Nav

<PageTitle>CncMes — Sipariş #@Id</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sipariş #@Id</h1>
    <a class="btn btn-link" href="/manager/orders">← Listeye dön</a>
</div>

@if (_notFound)
{
    <div class="alert alert-warning">Sipariş bulunamadı.</div>
}
else if (_detail is null || _customers is null)
{
    <p class="text-muted">Yükleniyor...</p>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3">Sipariş Bilgileri</h2>
                    <EditForm Model="@_header" OnValidSubmit="HandleHeaderSave">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Müşteri *</label>
                                <InputSelect class="form-select" @bind-Value="_header.CustomerId">
                                    @foreach (var c in _customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _header.CustomerId)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Durum *</label>
                                <InputSelect class="form-select" @bind-Value="_header.Status">
                                    @foreach (var s in OrderStatus.All)
                                    {
                                        <option value="@s">@OrderStatus.ToTurkish(s)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Sipariş Tarihi *</label>
                                <InputDate class="form-control" @bind-Value="_header.OrderDate" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Termin</label>
                                <InputDate class="form-control" @bind-Value="_header.DueDate" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notlar</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="_header.Notes" />
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_headerError))
                        {
                            <div class="alert alert-danger mt-3">@_headerError</div>
                        }

                        <div class="mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@_busy">Güncelle</button>
                            <button type="button" class="btn btn-outline-danger ms-auto"
                                    @onclick="HandleOrderDelete" disabled="@_busy">Siparişi Sil</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5">Özet</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Oluşturulma</dt>
                        <dd class="col-sm-7">@_detail.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                        <dt class="col-sm-5">Kalem Sayısı</dt>
                        <dd class="col-sm-7">@_detail.Items.Count</dd>
                        <dt class="col-sm-5">Toplam</dt>
                        <dd class="col-sm-7"><strong>@_detail.TotalPrice.ToString("N2") ₺</strong></dd>
                    </dl>
                    <hr />
                    <button class="btn btn-sm btn-outline-primary w-100"
                            @onclick="GenerateJobs" disabled="@(_busy || _detail.Items.Count == 0)">
                        Eksik iş emirlerini oluştur
                    </button>
                    @if (!string.IsNullOrEmpty(_jobMessage))
                    {
                        <div class="alert alert-info mt-2 mb-0 py-2 small">@_jobMessage</div>
                    }
                </div>
            </div>

            @if (_pnl is not null)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="h5 mb-0">Kar / Zarar</h2>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="DownloadPdf" disabled="@_pdfBusy">
                                @(_pdfBusy ? "Hazırlanıyor..." : "PDF indir")
                            </button>
                        </div>

                        @if (!_pnl.IsFullyCosted)
                        {
                            <div class="alert alert-warning py-2 small mb-2">
                                @_pnl.CompletedJobs/@_pnl.TotalJobs iş tamamlandı — maliyet kısmi, kar/zarar geçici.
                            </div>
                        }

                        <dl class="row mb-0 small">
                            <dt class="col-7">Gelir</dt>
                            <dd class="col-5 text-end">@_pnl.Revenue.ToString("N2") ₺</dd>
                            <dt class="col-7 fw-normal text-muted">Hammadde</dt>
                            <dd class="col-5 text-end text-muted">−@_pnl.MaterialCost.ToString("N2") ₺</dd>
                            <dt class="col-7 fw-normal text-muted">İşçilik</dt>
                            <dd class="col-5 text-end text-muted">−@_pnl.LaborCost.ToString("N2") ₺</dd>
                            <dt class="col-7 fw-normal text-muted">Elektrik</dt>
                            <dd class="col-5 text-end text-muted">−@_pnl.ElectricityCost.ToString("N2") ₺</dd>
                            <dt class="col-7 fw-normal text-muted">Takım Aşınması</dt>
                            <dd class="col-5 text-end text-muted">−@_pnl.ToolWearCost.ToString("N2") ₺</dd>
                            <dt class="col-7">Toplam Maliyet</dt>
                            <dd class="col-5 text-end">@_pnl.TotalCost.ToString("N2") ₺</dd>
                        </dl>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold">Kar / Zarar (%@_pnl.MarginPercent.ToString("N1"))</span>
                            <span class="fw-bold @(_pnl.Profit >= 0 ? "text-success" : "text-danger")">
                                @_pnl.Profit.ToString("N2") ₺
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(_pdfMessage))
                        {
                            <div class="alert alert-info mt-2 mb-0 py-2 small">@_pdfMessage</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <hr class="my-4" />

    <h2 class="h5 mb-3">Sipariş Kalemleri</h2>

    @if (_detail.Items.Count == 0)
    {
        <div class="alert alert-secondary">Bu siparişte henüz kalem yok.</div>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Parça</th>
                        <th class="text-center">Adet</th>
                        <th class="text-end">Birim Fiyat</th>
                        <th class="text-end">Tutar</th>
                        <th class="text-center">Ar-Ge</th>
                        <th class="text-center">STL</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _detail.Items)
                    {
                        <tr>
                            <td>
                                @item.PartName
                                @if (!string.IsNullOrEmpty(item.MaterialName))
                                {
                                    <div class="text-muted small">@item.MaterialName</div>
                                }
                                @if (item.EstimatedUnitPrice is decimal est && est != item.UnitPrice)
                                {
                                    <div class="text-primary small">
                                        Öneri: @est.ToString("N2") ₺
                                    </div>
                                }
                            </td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("N2") ₺</td>
                            <td class="text-end"><strong>@item.LineTotal.ToString("N2") ₺</strong></td>
                            <td class="text-center">@(item.IsRnD ? "Evet" : "—")</td>
                            <td class="text-center">
                                @if (item.HasStl)
                                {
                                    <span class="badge bg-success">✓</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary me-1"
                                   href="@($"/manager/items/{item.Id}/stl")">STL</a>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => RemoveItem(item.Id)" disabled="@_busy">Sil</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h3 class="h6">Yeni Kalem Ekle</h3>
            <EditForm Model="@_newItem" OnValidSubmit="HandleAddItem">
                <DataAnnotationsValidator />
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Parça Adı *</label>
                        <InputText class="form-control" @bind-Value="_newItem.PartName" />
                        <ValidationMessage For="@(() => _newItem.PartName)" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Adet *</label>
                        <InputNumber class="form-control" @bind-Value="_newItem.Quantity" />
                        <ValidationMessage For="@(() => _newItem.Quantity)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Birim Fiyat (₺) *</label>
                        <InputNumber class="form-control" @bind-Value="_newItem.UnitPrice" />
                        <ValidationMessage For="@(() => _newItem.UnitPrice)" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <InputCheckbox class="form-check-input" @bind-Value="_newItem.IsRnD" id="isRnD" />
                            <label class="form-check-label" for="isRnD">Ar-Ge</label>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary w-100" disabled="@_busy">Ekle</button>
                    </div>
                </div>
            </EditForm>
            @if (!string.IsNullOrEmpty(_itemError))
            {
                <div class="alert alert-danger mt-3 mb-0">@_itemError</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private OrderDetailDto? _detail;
    private List<CustomerDto>? _customers;
    private OrderProfitLossDto? _pnl;
    private UpdateOrderRequest _header = new();
    private OrderItemRequest _newItem = new();
    private bool _notFound;
    private bool _busy;
    private bool _pdfBusy;
    private string? _headerError;
    private string? _itemError;
    private string? _jobMessage;
    private string? _pdfMessage;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _detail = await Orders.GetAsync(Id);
        if (_detail is null) { _notFound = true; return; }

        _customers ??= (await Customers.ListAsync()).ToList();

        _header = new UpdateOrderRequest
        {
            CustomerId = _detail.CustomerId,
            OrderDate = _detail.OrderDate,
            DueDate = _detail.DueDate,
            Status = _detail.Status,
            Notes = _detail.Notes,
        };
        _newItem = new OrderItemRequest();

        _pnl = await ProfitLoss.GetOrderAsync(Id);
    }

    private async Task HandleHeaderSave()
    {
        _busy = true;
        _headerError = null;
        try
        {
            await Orders.UpdateAsync(Id, _header);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _headerError = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task HandleOrderDelete()
    {
        _busy = true;
        _headerError = null;
        try
        {
            await Orders.DeleteAsync(Id);
            Nav.NavigateTo("/manager/orders");
        }
        catch (Exception ex)
        {
            _headerError = ex.Message;
            _busy = false;
        }
    }

    private async Task HandleAddItem()
    {
        _busy = true;
        _itemError = null;
        try
        {
            await Orders.AddItemAsync(Id, _newItem);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _itemError = ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task GenerateJobs()
    {
        _busy = true;
        _jobMessage = null;
        try
        {
            var created = await Jobs.CreateMissingForOrderAsync(Id);
            _jobMessage = created == 0
                ? "Yeni iş emri oluşturulmadı (zaten her kalemin emri var)."
                : $"{created} yeni iş emri oluşturuldu. /manager/jobs ekranından atayabilirsin.";
        }
        catch (Exception ex)
        {
            _jobMessage = "Hata: " + ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task DownloadPdf()
    {
        if (_pnl is null) return;
        _pdfBusy = true;
        _pdfMessage = null;
        try
        {
            var lines = await ProfitLoss.ListOrderCostLinesAsync(Id);
            var bytes = ReportPdf.BuildOrderReport(_pnl, lines);

            var fileName = $"KarZarar_Siparis_{Id}.pdf";
            var path = Path.Combine(FileSystem.CacheDirectory, fileName);
            await File.WriteAllBytesAsync(path, bytes);

            await Launcher.Default.OpenAsync(new OpenFileRequest(
                "Kar/Zarar Raporu", new ReadOnlyFile(path)));
        }
        catch (Exception ex)
        {
            _pdfMessage = "PDF oluşturulamadı: " + ex.Message;
        }
        finally { _pdfBusy = false; }
    }

    private async Task RemoveItem(int itemId)
    {
        _busy = true;
        _itemError = null;
        try
        {
            await Orders.RemoveItemAsync(Id, itemId);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _itemError = ex.Message;
        }
        finally { _busy = false; }
    }
}
