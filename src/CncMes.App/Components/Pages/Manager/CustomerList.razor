@page "/manager/customers"
@attribute [Authorize(Roles = Roles.Manager)]
@using CncMes.Application.Sales
@inject ICustomerService Customers
@inject NavigationManager Nav

<PageTitle>CncMes — Müşteriler</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Müşteriler</h1>
    <a class="btn btn-primary" href="/manager/customers/new">+ Yeni Müşteri</a>
</div>

<div class="mb-3" style="max-width: 420px;">
    <input class="form-control" placeholder="Ad, telefon veya e-posta ara..."
           value="@_search" @oninput="OnSearchInput" />
</div>

@if (_loading)
{
    <p class="text-muted">Yükleniyor...</p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">
        <strong>Veri yüklenirken hata:</strong>
        <pre class="mb-0 mt-2" style="white-space:pre-wrap;">@_error</pre>
    </div>
}
else if (_items.Count == 0)
{
    <div class="alert alert-secondary">
        @(string.IsNullOrEmpty(_search) ? "Henüz müşteri yok." : "Aramaya uyan müşteri bulunamadı.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Telefon</th>
                    <th>E-posta</th>
                    <th>Vergi No</th>
                    <th class="text-center">Sipariş</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _items)
                {
                    <tr>
                        <td><strong>@c.Name</strong></td>
                        <td>@(c.Phone ?? "—")</td>
                        <td>@(c.Email ?? "—")</td>
                        <td>@(c.TaxNumber ?? "—")</td>
                        <td class="text-center">@c.OrderCount</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               href="@($"/manager/customers/{c.Id}")">Düzenle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CustomerDto> _items = new();
    private string _search = string.Empty;
    private bool _loading = true;
    private string? _error;
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var list = await Customers.ListAsync(string.IsNullOrWhiteSpace(_search) ? null : _search);
            _items = list.ToList();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(250, token);
            if (!token.IsCancellationRequested)
            {
                await LoadAsync();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }
}
